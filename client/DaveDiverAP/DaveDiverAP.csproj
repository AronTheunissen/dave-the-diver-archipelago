<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>DaveDiverAP</AssemblyName>
    <RootNamespace>DaveDiverAP</RootNamespace>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);8632</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <!-- Set GamePath here to auto-copy DLL after build. Leave empty to disable. -->
    <GamePath>C:\Program Files (x86)\Steam\steamapps\common\Dave the Diver</GamePath>
  </PropertyGroup>

  <Target Name="CopyToGame" AfterTargets="Build" Condition="'$(GamePath)' != '' AND Exists('$(GamePath)\\BepInEx\\plugins')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GamePath)\\BepInEx\\plugins\\" />
    <Message Text="Copied DaveDiverAP.dll to $(GamePath)\\BepInEx\\plugins\\" Importance="high" />
    <!-- Copy cimgui.dll (native ImGui binary) — required by ImGui.NET at runtime -->
    <Copy SourceFiles="$(TargetDir)cimgui.dll" DestinationFolder="$(GamePath)\\BepInEx\\plugins\\"
          Condition="Exists('$(TargetDir)cimgui.dll')" />
    <Message Text="Copied cimgui.dll to $(GamePath)\\BepInEx\\plugins\\" Importance="high"
             Condition="Exists('$(TargetDir)cimgui.dll')" />
    <Warning Text="cimgui.dll not found in build output — ImGui UI will not work!" 
             Condition="!Exists('$(TargetDir)cimgui.dll')" />
  </Target>

  <!-- Archipelago client via NuGet — no manual DLL needed -->
  <ItemGroup>
    <PackageReference Include="Archipelago.MultiClient.Net" Version="6.*" />
    <PackageReference Include="Newtonsoft.Json" Version="13.*" />
    <!-- ImGui for in-game UI — widely used in BepInEx mods -->
    <PackageReference Include="ImGui.NET" Version="1.*" />
  </ItemGroup>

  <!-- BepInEx references — copy from your BepInEx installation into client/lib/ -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>..\\lib\\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>..\\lib\\BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HarmonyX">
      <HintPath>..\\lib\\HarmonyX.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppcorlib">
      <HintPath>..\\lib\\Il2Cppcorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>..\\lib\\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Game interop assemblies — generated by BepInEx after first launch -->
  <!-- Copy from: <GamePath>/BepInEx/interop/ into client/lib/interop/ -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\\lib\\interop\\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>..\\lib\\interop\\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SaveSystem">
      <HintPath>..\\lib\\interop\\SaveSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="EzCoding">
      <HintPath>..\\lib\\interop\\EzCoding.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\\lib\\interop\\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\\lib\\interop\\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
